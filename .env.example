# MySQL connection string. Keep real credentials in .env.local, never in Git.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/jobs_territory"
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
SESSION_TTL_DAYS="7"
# Local development uses the private filesystem adapter. Set this to "s3"
# only when production object-storage configuration is available.
STORAGE_DRIVER="local"
STORAGE_BUCKET="jobs-territory-private"
STORAGE_REGION="ap-south-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Local development only. Keep this outside public/ and do not commit it.
STORAGE_LOCAL_DIR=".private-storage"
# Server-only AI configuration. Leave keys empty until a provider is connected.
GEMINI_API_KEY=""
GROQ_API_KEY=""
AI_PROVIDER="gemini"
