generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  COMPANY
  ADMIN
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationDocumentType {
  REGISTRATION_CERTIFICATE
  TAX_DOCUMENT
  IDENTITY_DOCUMENT
  OTHER
}

enum VerificationDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  SUSPENDED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

enum ReviewDecision {
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String            @map("password_hash")
  role              UserRole
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  candidateProfile  CandidateProfile?
  company           Company?
  applications      Application[]
  reviewRecords     AdminReviewRecord[]
  sessions          Session[]
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model CandidateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  fullName        String?  @map("full_name")
  phone           String?
  headline        String?
  bio             String?  @db.Text
  location        String?
  profilePhotoKey String?  @map("profile_photo_key")
  resumeKey       String?  @map("resume_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("candidate_profiles")
}

model Company {
  id              String        @id @default(cuid())
  ownerId         String        @unique @map("owner_id")
  name            String
  slug            String        @unique
  description     String?       @db.Text
  website         String?
  contactEmail    String        @map("contact_email")
  status          CompanyStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents       VerificationDocument[]
  jobs            Job[]
  reviews         AdminReviewRecord[]
  @@index([status])
  @@map("companies")
}

model VerificationDocument {
  id              String                     @id @default(cuid())
  companyId       String                     @map("company_id")
  type            VerificationDocumentType
  storageKey      String                     @map("storage_key")
  originalName    String                     @map("original_name")
  mimeType        String                     @map("mime_type")
  status          VerificationDocumentStatus @default(PENDING)
  rejectionReason String?                    @map("rejection_reason") @db.Text
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, status])
  @@map("verification_documents")
}

model Job {
  id             String    @id @default(cuid())
  companyId      String    @map("company_id")
  title          String
  description    String    @db.Text
  location       String?
  employmentType String?   @map("employment_type")
  salaryMin      Decimal?  @map("salary_min") @db.Decimal(12, 2)
  salaryMax      Decimal?  @map("salary_max") @db.Decimal(12, 2)
  status         JobStatus @default(DRAFT)
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications   Application[]
  @@index([status, publishedAt])
  @@index([companyId, status])
  @@map("jobs")
}

model Application {
  id          String            @id @default(cuid())
  jobId       String            @map("job_id")
  candidateId String            @map("candidate_id")
  coverNote   String?           @map("cover_note") @db.Text
  status      ApplicationStatus @default(SUBMITTED)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@unique([jobId, candidateId])
  @@index([candidateId, status])
  @@map("applications")
}

model AdminReviewRecord {
  id        String         @id @default(cuid())
  adminId   String         @map("admin_id")
  companyId String         @map("company_id")
  decision  ReviewDecision
  reason    String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")
  admin     User           @relation(fields: [adminId], references: [id], onDelete: Restrict)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, createdAt])
  @@map("admin_review_records")
}
